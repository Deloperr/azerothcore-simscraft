TX.KID_PLAY_LINES = { "Догоняй!", "Ты водишь!", "Чур, я рыцарь!", "Давай играть в драконов!", "Ха-ха, не поймаешь!",
    "Прятки! Раз, два, три...", "Смотри, что я нашёл(ла)!", "Давай строить замок!", "Я — Король-лич! Ууу!" }
